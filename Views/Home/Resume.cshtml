@{
    ViewData["Title"] = "Resume";
    ViewData["BodyClass"] = "page-resume theme-editorial";
}

@section Styles {
<style>
    .page-inner--resume {
        position: relative;
        background: #421C2C;
    }

    .page-inner--resume .page-header__title {
        letter-spacing: -0.03em;
    }

    .page-inner--resume .page-header__lead {
        max-width: 760px;
        color: #E4C6C6;
    }

    .resume-page {
        padding: 2rem 0 4.5rem;
    }

    .resume-layout {
        display: grid;
        grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
        gap: 1.5rem;
        align-items: start;
    }

    .resume-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        position: sticky;
        top: calc(var(--navbar-height, 80px) + 1rem);
    }

    .resume-card {
        background: #321823;
        border: 1px solid rgba(232, 183, 183, 0.2);
        border-radius: 1.125rem;
        box-shadow: none;
        padding: 1.5rem;
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    .resume-card:hover {
        transform: translateY(-2px);
        border-color: rgba(232, 183, 183, 0.55);
        box-shadow: 0 18px 40px rgba(42, 18, 28, 0.28);
    }

    .resume-card__title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #FCF3EE;
        margin: 0 0 1rem;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        letter-spacing: -0.02em;
    }

    .resume-card__title::before {
        content: '';
        width: 4px;
        height: 1.15rem;
        border-radius: 999px;
        background: #E8B7B7;
        flex-shrink: 0;
    }

    .resume-profile {
        text-align: center;
    }

    .resume-profile__photo {
        width: 132px;
        height: 132px;
        object-fit: cover;
        object-position: center 26%;
        border-radius: 1.25rem;
        border: 3px solid rgba(232, 183, 183, 0.45);
        box-shadow: none;
        margin-bottom: 1rem;
    }

    .resume-profile__name {
        font-size: 1.25rem;
        font-weight: 800;
        color: #FCF3EE;
        margin: 0 0 0.35rem;
        letter-spacing: -0.03em;
    }

    .resume-profile__role {
        font-size: 0.92rem;
        color: #E4C6C6;
        margin: 0 0 0.2rem;
        font-weight: 600;
    }

    .resume-profile__location {
        font-size: 0.85rem;
        color: #E4C6C6;
        margin: 0 0 1rem;
    }

    .resume-contact-list {
        list-style: none;
        padding: 0;
        margin: 0 0 1.1rem;
        text-align: left;
    }

    .resume-contact-list li {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-size: 0.88rem;
        color: #E4C6C6;
        padding: 0.45rem 0;
        border-bottom: 1px solid rgba(232, 183, 183, 0.16);
    }

    .resume-contact-list li:last-child {
        border-bottom: none;
    }

    .resume-contact-list i {
        width: 1.1rem;
        color: #E8B7B7;
        text-align: center;
    }

    .resume-contact-list a {
        color: #E4C6C6;
        text-decoration: none;
    }

    .resume-contact-list a:hover {
        color: #FCF3EE;
        text-decoration: underline;
    }

    .resume-socials {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 1.1rem;
    }

    .resume-socials a {
        width: 42px;
        height: 42px;
        border-radius: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #FCF3EE;
        background: rgba(252, 243, 238, 0.06);
        border: 1px solid rgba(232, 183, 183, 0.28);
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .resume-socials a:hover {
        transform: translateY(-2px);
        border-color: transparent;
        background: #E8B7B7;
        color: #421C2C;
    }

    .resume-download-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.8rem 1rem;
        border: none;
        border-radius: 0.9rem;
        font-weight: 700;
        color: #421C2C;
        background: #E8B7B7;
        box-shadow: none;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .resume-download-btn:hover {
        transform: translateY(-2px);
        box-shadow: none;
        color: #421C2C;
    }

    .resume-bottom-actions {
        margin-top: 2rem;
        padding-top: 0.25rem;
        display: flex;
        justify-content: center;
    }

    .resume-download-btn--references {
        width: auto;
        min-width: min(100%, 320px);
        padding-inline: 1.35rem;
        background: transparent;
        border: 1px solid rgba(232, 183, 183, 0.45);
        box-shadow: none;
        color: #FCF3EE;
    }

    .resume-download-btn--references:hover {
        background: rgba(232, 183, 183, 0.12);
        border-color: #E8B7B7;
        box-shadow: none;
        color: #FCF3EE;
    }

    .resume-skill-group + .resume-skill-group {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(232, 183, 183, 0.16);
    }

    .resume-skill-group__label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #E4C6C6;
        margin: 0 0 0.55rem;
    }

    .resume-skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .resume-skill-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.28rem 0.55rem;
        border-radius: 999px;
        font-size: 0.73rem;
        font-weight: 600;
        color: #FCF3EE;
        background: rgba(232, 183, 183, 0.12);
        border: 1px solid rgba(232, 183, 183, 0.28);
    }

    .resume-main {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .resume-profile-text {
        font-size: 0.98rem;
        line-height: 1.75;
        color: #E4C6C6;
        margin: 0;
    }

    .resume-timeline {
        display: flex;
        flex-direction: column;
        gap: 1.35rem;
    }

    .resume-job {
        position: relative;
        padding-left: 1.35rem;
    }

    .resume-job::before {
        content: '';
        position: absolute;
        left: 0.28rem;
        top: 0.45rem;
        bottom: -1.35rem;
        width: 2px;
        background: rgba(232, 183, 183, 0.35);
    }

    .resume-job:last-child::before {
        bottom: 0.45rem;
    }

    .resume-job::after {
        content: '';
        position: absolute;
        left: 0;
        top: 0.35rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #E8B7B7;
        box-shadow: 0 0 0 4px rgba(232, 183, 183, 0.16);
    }

    .resume-job__head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.55rem;
    }

    .resume-job__title {
        font-size: 1rem;
        font-weight: 700;
        color: #FCF3EE;
        margin: 0 0 0.15rem;
    }

    .resume-job__company {
        font-size: 0.86rem;
        color: #E4C6C6;
        margin: 0;
        font-weight: 600;
    }

    .resume-date-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.28rem 0.55rem;
        border-radius: 999px;
        font-size: 0.73rem;
        font-weight: 600;
        color: #FCF3EE;
        background: rgba(232, 183, 183, 0.12);
        border: 1px solid rgba(232, 183, 183, 0.28);
        white-space: nowrap;
    }

    .resume-job ul,
    .resume-projects {
        margin: 0;
        padding-left: 1.1rem;
        color: #E4C6C6;
        font-size: 0.9rem;
        line-height: 1.65;
    }

    .resume-job li + li,
    .resume-projects li + li {
        margin-top: 0.35rem;
    }

    .resume-edu-item + .resume-edu-item {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(232, 183, 183, 0.16);
    }

    .resume-edu-item h4 {
        font-size: 0.95rem;
        font-weight: 700;
        color: #FCF3EE;
        margin: 0 0 0.2rem;
    }

    .resume-edu-item p {
        font-size: 0.84rem;
        color: #E4C6C6;
        margin: 0;
        font-weight: 600;
    }

    .resume-projects li strong {
        color: #FCF3EE;
    }

    @@media (max-width: 991.98px) {
        .resume-layout {
            grid-template-columns: 1fr;
        }

        .resume-sidebar {
            position: static;
        }
    }

    @@media (max-width: 575.98px) {
        .resume-page {
            padding-top: 1.25rem;
        }

        .resume-card {
            padding: 1.15rem;
        }

        .resume-job__head {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
}

