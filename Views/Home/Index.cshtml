@model AnastasiiaPortfolio.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "page-home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
}

<section id="home" class="hero-section" aria-label="Introduction">
    <div class="hero-canvas">
        <div class="hero-layout">
            <div class="hero-copy">
                <p class="hero-kicker" data-motion-before-typewriter>
                    <span class="hero-kicker__dot" aria-hidden="true"></span>
                    Available for opportunities · Ontario, Canada
                </p>
                <h1 class="hero-headline" data-motion-before-typewriter>
                    <span class="hero-headline__line">Building elegant</span>
                    <span class="hero-headline__line hero-headline__line--accent">
                        <span class="hero-rotate" data-rotate-words="web applications|Shopify storefronts|digital experiences|high-performance sites" aria-live="polite">
                            <span class="hero-rotate__word is-active">web applications</span>
                        </span>
                    </span>
                    <span class="hero-headline__line">that perform<span class="hero-headline__period">.</span></span>
                </h1>
                <p class="hero-lead" data-motion-after-typewriter>Full-stack developer with 5+ years building websites, Shopify stores, web apps, and brand experiences — from idea to launch.</p>
                <div class="hero-actions" data-motion-after-typewriter>
                    <a asp-controller="Home" asp-action="Projects" class="hero-cta hero-cta--primary">
                        <span aria-hidden="true">&lt;/&gt;</span>
                        View My Work
                        <span class="hero-cta__arrow" aria-hidden="true">→</span>
                    </a>
                    <a asp-controller="Home" asp-action="Resume" class="hero-cta">
                        <i class="fas fa-file-lines" aria-hidden="true"></i>
                        View Resume
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="hero-cta">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        Contact Me
                    </a>
                </div>
                <ul class="hero-proof" data-motion-after-typewriter>
                    <li>
                        <span class="hero-proof__icon" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
                        <span><strong>5+ Years</strong>Experience</span>
                    </li>
                    <li>
                        <span class="hero-proof__icon" aria-hidden="true"><i class="fas fa-laptop-code"></i></span>
                        <span><strong>Full-Stack</strong>Development</span>
                    </li>
                    <li>
                        <span class="hero-proof__icon" aria-hidden="true"><i class="fas fa-bag-shopping"></i></span>
                        <span><strong>Shopify</strong>Expertise</span>
                    </li>
                    <li>
                        <span class="hero-proof__icon" aria-hidden="true"><i class="fas fa-database"></i></span>
                        <span><strong>.NET</strong>&amp; Databases</span>
                    </li>
                </ul>
            </div>
            <div class="hero-visual" data-motion-float>
                <svg class="hero-arc" viewBox="0 0 520 640" fill="none" aria-hidden="true">
                    <path d="M40 600C190 520 330 360 470 40" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
                </svg>
                <div class="hero-frame">
                    <span class="hero-spark hero-spark--a" aria-hidden="true"></span>
                    <span class="hero-spark hero-spark--b" aria-hidden="true"></span>
                    <div class="hero-portrait">
                        <img src="~/images/hero-portrait.jpg" asp-append-version="true" alt="Anastasiia Khrustaleva, software developer" class="hero-portrait-img" data-skip-global-img width="864" height="1152" fetchpriority="high" decoding="async">
                    </div>
                    <ul class="hero-chips" aria-label="Core technologies">
                        <li class="hero-chip hero-chip--net" style="--float-dur: 5.4s; --float-delay: 0.1s" data-motion-after-typewriter>
                            <span class="hero-chip__float"><span class="hero-chip__mark hero-chip__mark--net" aria-hidden="true">.N</span><span class="hero-chip__label" data-chip-type=".NET"><span class="hero-chip__ghost" aria-hidden="true">.NET</span><span class="hero-chip__typed">.NET</span></span></span>
                        </li>
                        <li class="hero-chip hero-chip--shop" style="--float-dur: 4.8s; --float-delay: 0.6s" data-motion-after-typewriter>
                            <span class="hero-chip__float"><span class="hero-chip__mark hero-chip__mark--shop" aria-hidden="true"><i class="fab fa-shopify"></i></span><span class="hero-chip__label" data-chip-type="Shopify"><span class="hero-chip__ghost" aria-hidden="true">Shopify</span><span class="hero-chip__typed">Shopify</span></span></span>
                        </li>
                        <li class="hero-chip hero-chip--js" style="--float-dur: 5.8s; --float-delay: 0.3s" data-motion-after-typewriter>
                            <span class="hero-chip__float"><span class="hero-chip__mark hero-chip__mark--js" aria-hidden="true">JS</span><span class="hero-chip__label" data-chip-type="JavaScript"><span class="hero-chip__ghost" aria-hidden="true">JavaScript</span><span class="hero-chip__typed">JavaScript</span></span></span>
                        </li>
                        <li class="hero-chip hero-chip--sql" style="--float-dur: 4.6s; --float-delay: 0.9s" data-motion-after-typewriter>
                            <span class="hero-chip__float"><span class="hero-chip__mark hero-chip__mark--sql" aria-hidden="true"><i class="fas fa-database"></i></span><span class="hero-chip__label" data-chip-type="SQL"><span class="hero-chip__ghost" aria-hidden="true">SQL</span><span class="hero-chip__typed">SQL</span></span></span>
                        </li>
                        <li class="hero-chip hero-chip--csharp" style="--float-dur: 5.1s; --float-delay: 0.45s" data-motion-after-typewriter>
                            <span class="hero-chip__float"><span class="hero-chip__mark hero-chip__mark--csharp" aria-hidden="true">C#</span><span class="hero-chip__label" data-chip-type="C#"><span class="hero-chip__ghost" aria-hidden="true">C#</span><span class="hero-chip__typed">C#</span></span></span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="story-scroll story-scroll--after-hero" id="process" aria-label="How I work">
    <div class="container">
        <div class="story-scroll__inner">
            <div class="story-scroll__visual-wrap">
                <div class="story-scroll__visual" id="storyVisual">
                    <div class="story-scroll__panel is-active" data-story-panel="design">
                        <img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&fit=crop&w=900&q=80" alt="UI design workspace" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 01</p>
                            <p class="story-scroll__panel-title">Strategy, UX &amp; visual direction</p>
                        </div>
                    </div>
                    <div class="story-scroll__panel" data-story-panel="build">
                        <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=900&q=80" alt="Development on laptop" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 02</p>
                            <p class="story-scroll__panel-title">Development that ships clean</p>
                        </div>
                    </div>
                    <div class="story-scroll__panel" data-story-panel="launch">
                        <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=900&q=80" alt="E-commerce checkout experience" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 03</p>
                            <p class="story-scroll__panel-title">Deploy, measure &amp; improve</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="story-scroll__steps" role="list">
                <article class="story-step is-active" data-story-step="design" role="listitem" tabindex="0">
                    <p class="story-step__num">01 — Design</p>
                    <h3>Strategy, UX, and visual direction</h3>
                    <p>Page structure, user flows, and branded interfaces — from wireframes to polished UI — so every project starts with clarity and conversion in mind.</p>
                </article>
                <article class="story-step" data-story-step="build" role="listitem" tabindex="0">
                    <p class="story-step__num">02 — Build</p>
                    <h3>Development that ships clean</h3>
                    <p>ASP.NET Core, JavaScript, WordPress, Shopify, APIs, and databases — responsive, accessible, and ready for real users and real traffic.</p>
                </article>
                <article class="story-step" data-story-step="launch" role="listitem" tabindex="0">
                    <p class="story-step__num">03 — Launch</p>
                    <h3>Deploy, measure, improve</h3>
                    <p>Hosting, SEO, performance tuning, and post-launch updates — so the site stays fast, findable, and easy to grow after go-live.</p>
                </article>
            </div>
        </div>

        <article class="home-case home-case--after-process" aria-labelledby="home-case-one80-title">
            <div class="home-case__body">
                <p class="home-case__eyebrow">Featured Shopify work</p>
                <h3 class="home-case__title" id="home-case-one80-title">ONE80 Revolution</h3>
                <p class="home-case__lead">Precision hydration brand storefront — product pages, mobile UX, checkout setup, redirects, and post-launch merchant support.</p>
                <ul class="home-case__points">
                    <li><strong>Problem</strong> Make a technical product feel simple to buy on mobile.</li>
                    <li><strong>Approach</strong> Design the purchase path, then ship it in Shopify theme code.</li>
                    <li><strong>Result</strong> Live storefront with clearer PDPs and ongoing updates.</li>
                </ul>
                <div class="home-case__stack" aria-label="Stack">
                    <span>Shopify</span><span>Liquid</span><span>JavaScript</span><span>CSS</span><span>Checkout UX</span>
                </div>
                <a asp-controller="Home" asp-action="Projects" class="home-case__link">See all projects <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="home-case__media">
                <img class="home-case__img" src="~/images/one80/storefront.png" alt="ONE80 Revolution Shopify storefront" loading="lazy" asp-append-version="true" />
                <span class="home-case__badge">Shopify case study</span>
            </div>
        </article>
    </div>
</section>

<section class="home-stats home-stats--motion" aria-label="Experience and expertise">
    <div class="home-stats__ambient" aria-hidden="true">
        <span class="home-stats__orb home-stats__orb--amber"></span>
        <span class="home-stats__orb home-stats__orb--violet"></span>
        <span class="home-stats__orb home-stats__orb--mint"></span>
    </div>
    <div class="container">
        <header class="home-stats__header home-stats__header--open">
            <p class="home-stats__eyebrow">What I do</p>
            <h2 class="home-stats__title">
                <span class="home-stats__title-line">Developer who designs,</span>
                <span class="home-stats__title-line home-stats__title-line--accent">designer who ships</span>
            </h2>
            <p class="home-stats__lead">
                <span class="home-stats__experience">5+ years</span>
                building Shopify storefronts, full-stack apps, WordPress themes, and brand systems — from first sketch to production and support.
            </p>
            <div class="home-stats__metrics" aria-label="Highlights">
                <div class="home-stats__metric"><strong>Shopify</strong><span>storefronts &amp; themes</span></div>
                <div class="home-stats__metric"><strong>Full-stack</strong><span>APIs to UI</span></div>
                <div class="home-stats__metric"><strong>Design</strong><span>brand to pixels</span></div>
                <div class="home-stats__metric"><strong>Launch</strong><span>hosting &amp; support</span></div>
            </div>
        </header>

        <div class="home-stats__grid home-stats__grid--bento">
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="fullstack">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fas fa-laptop-code"></i></p>
                    <span class="home-stat-card__num">01</span>
                </div>
                <h3 class="home-stat-card__label">Full-stack development</h3>
                <p class="home-stat-card__detail">Business logic, APIs, databases, auth, admin panels, and interactive features — not just front-end mockups.</p>
                <div class="home-stat-card__tags" aria-label="Development skills">
                    <span>ASP.NET Core</span><span>C#</span><span>REST APIs</span><span>Entity Framework</span><span>MongoDB</span><span>SignalR</span>
                </div>
            </article>
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="ecommerce">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fab fa-shopify"></i></p>
                    <span class="home-stat-card__num">02</span>
                </div>
                <h3 class="home-stat-card__label">E-commerce &amp; Shopify</h3>
                <p class="home-stat-card__detail">Storefronts, product pages, checkout flows, Liquid themes, mobile UX, redirects, subscriptions, and post-launch merchant support.</p>
                <div class="home-stat-card__tags" aria-label="E-commerce skills">
                    <span>Shopify</span><span>Liquid</span><span>WooCommerce</span><span>Checkout UX</span><span>Conversion design</span>
                </div>
            </article>
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="wordpress">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fab fa-wordpress"></i></p>
                    <span class="home-stat-card__num">03</span>
                </div>
                <h3 class="home-stat-card__label">WordPress &amp; CMS builds</h3>
                <p class="home-stat-card__detail">Custom themes, Gutenberg blocks, WooCommerce, ACF, block patterns, SEO plugins, and production-ready site structure.</p>
                <div class="home-stat-card__tags" aria-label="CMS skills">
                    <span>WordPress</span><span>Gutenberg</span><span>ACF</span><span>theme.json</span><span>Rank Math</span><span>Kinsta</span>
                </div>
            </article>
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="design">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fas fa-palette"></i></p>
                    <span class="home-stat-card__num">04</span>
                </div>
                <h3 class="home-stat-card__label">UI/UX, brand &amp; creative</h3>
                <p class="home-stat-card__detail">Wireframes, visual systems, landing pages, ad creative, social content, and polished interfaces that match the brand.</p>
                <div class="home-stat-card__tags" aria-label="Design skills">
                    <span>UI/UX</span><span>Figma</span><span>Photoshop</span><span>Brand design</span><span>Canva</span><span>CapCut</span>
                </div>
            </article>
        </div>

        <div class="home-stats__delivered reveal-ready" data-home-stats-chips>
            <div class="home-stats__delivered-head">
                <p class="home-stats__delivered-eyebrow">Delivered</p>
                <h3 class="home-stats__delivered-title">Types of work I've done</h3>
