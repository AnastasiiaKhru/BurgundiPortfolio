@{
    ViewData["Title"] = "Projects";
    ViewData["BodyClass"] = "page-projects theme-editorial";
}
@section Styles {
<style>
    .page-inner--projects .projects-filter {
        top: 74px;
        padding: 0.9rem;
        margin-bottom: 2rem;
        border-radius: 1rem;
    }

    .page-inner--projects .projects-grid {
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fill, minmax(335px, 1fr));
    }

    .page-inner--projects .project-card__title {
        font-size: clamp(1.35rem, 1.18rem + 0.55vw, 1.7rem);
    }

    .page-inner--projects .project-card__preview {
        border-radius: 1rem;
    }

    @@media (max-width: 768px) {
        .page-inner--projects .projects-filter {
            top: 62px;
            padding: 0.7rem;
        }
    }
</style>
}
<div class="page-inner page-inner--projects">
    <header class="page-header">
        <div class="container">
            <p class="page-header__label">Selected work</p>
            <h1 class="page-header__title">All the work.</h1>
            <p class="page-header__lead">Shopify storefronts, WordPress sites, full-stack apps, brand systems, and interactive pieces. Filter by the kind of work.</p>
            <ol class="page-hero__craft">
                <li><span>01</span> Commerce and storefronts</li>
                <li><span>02</span> Sites, apps, and tools</li>
                <li><span>03</span> Brand, marketing, and games</li>
            </ol>
            <div class="page-hero__actions">
                <a class="gbtn gbtn--fill" href="#work">Browse the work</a>
                <a class="gbtn gbtn--line" asp-controller="Home" asp-action="Contact">Hire me</a>
            </div>
        </div>
    </header>

    <section class="projects-showcase" id="work">
        <div class="container container--projects-wide">
            <div class="projects-filter" role="tablist">
                <button class="filter-btn active" data-filter="all" aria-selected="true">All</button>
                <button class="filter-btn" data-filter="ecommerce">E-Commerce</button>
                <button class="filter-btn" data-filter="marketing">Marketing</button>
                <button class="filter-btn" data-filter="crm">CRM</button>
                <button class="filter-btn" data-filter="game">Games</button>
                <button class="filter-btn" data-filter="content">Content Creation</button>
                <button class="filter-btn" data-filter="fullstack">Full-Stack</button>
            </div>

            <partial name="_ProjectsPartial" />
        </div>
    </section>
</div>
