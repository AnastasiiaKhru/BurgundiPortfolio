@{
    ViewData["Title"] = "Skills";
    ViewData["BodyClass"] = "page-skills theme-editorial";
}
@section Styles {
    <link rel="stylesheet" href="~/css/skills-page.css" asp-append-version="true" />
}
<div class="page-inner page-inner--skills">
    <header class="page-header">
        <div class="container">
            <p class="page-header__label">Skills</p>
            <h1 class="page-header__title">Front end and back end.</h1>
            <p class="page-header__lead">Websites and applications. Interface, ASP.NET, APIs, and Shopify.</p>
            <div class="page-hero__actions">
                <a class="gbtn gbtn--fill" asp-controller="Home" asp-action="Projects">See the work</a>
            </div>
        </div>
    </header>

    <div class="tech-marquee" aria-label="Technologies I work with">
        <div class="tech-marquee__track">
            <span class="tech-marquee__item"><i class="fab fa-shopify"></i> Shopify</span>
            <span class="tech-marquee__item"><i class="fab fa-microsoft"></i> .NET</span>
            <span class="tech-marquee__item"><i class="fab fa-js-square"></i> JavaScript</span>
            <span class="tech-marquee__item"><i class="fab fa-react"></i> React</span>
            <span class="tech-marquee__item"><i class="fab fa-html5"></i> HTML5</span>
            <span class="tech-marquee__item"><i class="fab fa-css3-alt"></i> CSS3</span>
            <span class="tech-marquee__item"><i class="fas fa-database"></i> SQL</span>
            <span class="tech-marquee__item"><i class="fab fa-wordpress"></i> WordPress</span>
            <span class="tech-marquee__item"><i class="fab fa-figma"></i> Figma</span>
            <span class="tech-marquee__item"><i class="fab fa-git-alt"></i> Git</span>
            <span class="tech-marquee__item"><i class="fas fa-leaf"></i> MongoDB</span>
            <span class="tech-marquee__item"><i class="fas fa-bolt"></i> Tailwind</span>
            <span class="tech-marquee__item"><i class="fab fa-docker"></i> Docker</span>
            <span class="tech-marquee__item"><i class="fas fa-cloud"></i> Azure</span>
            <span class="tech-marquee__item"><i class="fas fa-palette"></i> UI/UX</span>
            <span class="tech-marquee__item"><i class="fas fa-chart-line"></i> SEO</span>
            <span class="tech-marquee__item"><i class="fab fa-shopify"></i> Shopify</span>
            <span class="tech-marquee__item"><i class="fab fa-microsoft"></i> .NET</span>
            <span class="tech-marquee__item"><i class="fab fa-js-square"></i> JavaScript</span>
            <span class="tech-marquee__item"><i class="fab fa-react"></i> React</span>
            <span class="tech-marquee__item"><i class="fab fa-html5"></i> HTML5</span>
            <span class="tech-marquee__item"><i class="fab fa-css3-alt"></i> CSS3</span>
            <span class="tech-marquee__item"><i class="fas fa-database"></i> SQL</span>
            <span class="tech-marquee__item"><i class="fab fa-wordpress"></i> WordPress</span>
            <span class="tech-marquee__item"><i class="fab fa-figma"></i> Figma</span>
            <span class="tech-marquee__item"><i class="fab fa-git-alt"></i> Git</span>
            <span class="tech-marquee__item"><i class="fas fa-leaf"></i> MongoDB</span>
            <span class="tech-marquee__item"><i class="fas fa-bolt"></i> Tailwind</span>
            <span class="tech-marquee__item"><i class="fab fa-docker"></i> Docker</span>
            <span class="tech-marquee__item"><i class="fas fa-cloud"></i> Azure</span>
            <span class="tech-marquee__item"><i class="fas fa-palette"></i> UI/UX</span>
            <span class="tech-marquee__item"><i class="fas fa-chart-line"></i> SEO</span>
        </div>
    </div>

    <div id="skills-list">
        <partial name="_SkillsPartial" />
    </div>
</div>
